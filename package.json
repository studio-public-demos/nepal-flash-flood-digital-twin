{
  "name": "nepal-flash-flood-digital-twin",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "npm run generate:nepal",
    "generate:nepal": "node scripts/data/refresh-canonical-scenarios.mjs",
    "build:nepal": "esbuild src/nepal-flash-flood/app.ts --bundle --format=esm --target=es2020 --outfile=app.js",
    "build": "npm run build:nepal",
    "validate:data": "node scripts/validate-static-build.mjs",
    "validate:geography": "node scripts/validate-geography.mjs",
    "validate:physics": "node scripts/validate-physics.mjs",
    "validate:3d": "node scripts/validate-spatial-3d.mjs",
    "verify:release": "npm run generate && npm run validate:data && npm run validate:geography && npm run validate:physics && npm run validate:3d && npm test && npm run typecheck && npm run lint && npm run e2e && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run tests/nepal-flash-flood",
    "e2e": "playwright test",
    "social:package": "node scripts/create-social-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cesium": "^1.121.1",
    "esbuild": "^0.23.0",
    "eslint": "^9.9.0",
    "http-server": "^14.1.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
